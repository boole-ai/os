# ========================================
# IMAGINE OS - ENTERPRISE CONFIGURATION
# ========================================

# Application
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://os.boole.ai

# ========================================
# ANALYTICS & MONITORING
# ========================================

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=os.boole.ai

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Custom Analytics Endpoint
NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://analytics.boole.ai/events

# ========================================
# ERROR TRACKING
# ========================================

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxx@xxxxx.ingest.sentry.io/xxxxxxx
SENTRY_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxx

# ========================================
# MONITORING & OBSERVABILITY
# ========================================

# DataDog
DD_API_KEY=xxxxxxxxxxxxxxxxxxxxx
DD_SITE=datadoghq.com

# New Relic
NEW_RELIC_LICENSE_KEY=xxxxxxxxxxxxxxxxxxxxx
NEW_RELIC_APP_NAME=imagine-os

# ========================================
# PAYMENTS
# ========================================

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ========================================
# EMAIL & NOTIFICATIONS
# ========================================

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=sales@boole.ai

# Slack (for internal notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxxxxxxxxxxxxxxxxxx

# ========================================
# CRM & SALES
# ========================================

# HubSpot
HUBSPOT_API_KEY=xxxxxxxxxxxxxxxxxxxxx
HUBSPOT_PORTAL_ID=xxxxxxxxxxxxxxxxxxxxx

# Salesforce
SALESFORCE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx
SALESFORCE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx
SALESFORCE_USERNAME=sales@boole.ai
SALESFORCE_PASSWORD=xxxxxxxxxxxxxxxxxxxxx

# ========================================
# RATE LIMITING & SECURITY
# ========================================

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxx

# Vercel Firewall
VERCEL_FIREWALL_KEY=xxxxxxxxxxxxxxxxxxxxx

# ========================================
# FEATURE FLAGS
# ========================================

# LaunchDarkly
LAUNCHDARKLY_SDK_KEY=sdk-xxxxxxxxxxxxxxxxxxxxx

# ========================================
# DEPLOYMENT
# ========================================

# Vercel
VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxxx
VERCEL_ORG_ID=team_xxxxxxxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxx

# ========================================
# INTERNAL LOGGING
# ========================================

LOG_ENDPOINT=https://logs.boole.ai/ingest
LOG_LEVEL=info
